{
  "name": "braindump",
  "productName": "Braindump",
  "version": "0.1.0",
  "description": "Rapid-fire notes app for Windows — group, complete, pin, archive, with LLM auto-format, Ramble and Brainstorm.",
  "private": true,
  "author": {
    "name": "James Hooks",
    "email": "noreply@example.com"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:linux": "npm run build && electron-builder --linux --x64",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@google/generative-ai": "^0.21.0",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "framer-motion": "^11.11.1",
    "immer": "^10.1.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.0.7",
    "openai": "^4.68.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "eslint": "^9.12.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.2"
  },
  "build": {
    "appId": "com.jamesdhooks.braindump",
    "productName": "Braindump",
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "build/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Braindump"
    },
    "portable": {
      "artifactName": "Braindump-Portable-${version}.${ext}"
    }
  }
}
